<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for Bolt C++ ML.

  This committed manifest declares only the always-built console application
  (bin\bolt.exe). An MSIX manifest cannot contain conditional entries, so the
  optional desktop GUI (bin\gui_main.exe, built only when ImGui/GLFW/OpenGL
  are available) is added by scripts/package-msix.ps1 at staging time when
  the executable is present in the install tree. The script then also renames
  the console entry to "Bolt Console" to match the NSIS shortcut labels.

  The Publisher is a development placeholder. For Microsoft Store submission
  replace Identity/@Name and Identity/@Publisher with the values reserved in
  Partner Center (see docs/WINDOWS_PACKAGING.md).
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">

  <Identity Name="BoltCppML.IDE"
            Publisher="CN=BoltCppML Dev"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Bolt C++ ML</DisplayName>
    <PublisherDisplayName>Bolt C++ ML Project</PublisherDisplayName>
    <Description>Bolt C++ ML - AI-powered IDE with machine learning integration (GGML/GGUF model inference, AI code completion, generation and refactoring).</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Bolt"
                 Executable="bin\bolt.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Bolt C++ ML"
                          Description="Bolt C++ ML console application"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
